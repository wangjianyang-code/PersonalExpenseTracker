@model IEnumerable<PersonalExpenseTracker.Models.CartItem>

@{
    ViewData["Title"] = "Shopping Cart";
}

<h2>Shopping Cart</h2>

<div class="mb-3">
    <a asp-action="Add"
       class="btn btn-primary">
        Add Item
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Your cart is empty.
    </div>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Description</th>
                <th>Quantity</th>
                <th>Unit Price</th>
                <th>Total</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Description</td>
                    <td>@item.Quantity</td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>@item.Total.ToString("C")</td>

                    <td>
                        <form asp-action="Remove"
                              method="post">

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Remove
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="text-end mb-3">
        <strong>
            Cart Total:
            @Model.Sum(x => x.Total).ToString("C")
        </strong>
    </div>

    <form asp-controller="Order"
          asp-action="CreateFromCart"
          method="post">

        <button type="submit"
                class="btn btn-success">
            Create Order
        </button>
    </form>
}