@model PersonalExpenseTracker.Models.Transaction

@{
    ViewData["Title"] = "Transaction Details";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h3>Transaction Details</h3>
        </div>

        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Description</dt>
                <dd class="col-sm-9">@Model.Description</dd>

                <dt class="col-sm-3">Type</dt>
                <dd class="col-sm-9">@Model.Type</dd>

                <dt class="col-sm-3">Amount</dt>
                <dd class="col-sm-9">@Model.Amount.ToString("C")</dd>

                <dt class="col-sm-3">Date</dt>
                <dd class="col-sm-9">@Model.Date.ToString("yyyy-MM-dd")</dd>

                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Category?.Name</dd>

                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">@Model.Notes</dd>
            </dl>

            <a asp-controller="Transaction"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">
                Edit
            </a>

            <a asp-controller="Transaction"
               asp-action="Index"
               class="btn btn-secondary">
                Back to List
            </a>
        </div>
    </div>
</div>